{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=SmartSchoolSaaS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "SmartSchool",
    "Audience": "SmartSchool.Client",
    "SigningKey": "",
    "TokenLifetimeMinutes": 480
  },
  "Session": {
    "IdleTimeoutMinutes": 60,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "CreateDemoData": false,
    "ShowDemoAccounts": false,
    "SuperAdminEmail": "superadmin@smartschool.local",
    "SuperAdminPassword": "",
    "DemoPassword": ""
  },
  "Monitoring": {
    "SlowRequestMs": 800
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartschool-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
