{
  "//": "Copy to appsettings.Production.json on the server, or set the same keys as environment variables (Jwt__SigningKey, ConnectionStrings__Default, ...). Never commit real secrets.",
  "ConnectionStrings": {
    "Default": "Server=SQLSERVER_HOST;Database=SmartSchoolSaaS;User Id=smartschool_app;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS",
    "TokenLifetimeMinutes": 480
  },
  "Session": {
    "IdleTimeoutMinutes": 60
  },
  "Seed": {
    "CreateDemoData": false,
    "ShowDemoAccounts": false,
    "SuperAdminEmail": "owner@your-domain.com",
    "SuperAdminPassword": "ONLY_USED_ON_FIRST_START_CHANGE_AFTER_SIGN_IN"
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  },
  "ReverseProxy": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.your-domain.com" ]
  },
  "Monitoring": {
    "SlowRequestMs": 800,
    "TechnicalLogRetentionDays": 30,
    "PageViewRetentionDays": 365
  },
  "AllowedHosts": "api.your-domain.com;app.your-domain.com"
}
