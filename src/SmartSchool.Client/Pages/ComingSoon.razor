@page "/soon/{Module}"

<PageTitle>@Title · SmartSchool</PageTitle>

<div class="empty">
    <div class="empty-icon"><i class="ti ti-tools" style="font-size:3rem"></i></div>
    <p class="empty-title">@Title</p>
    <p class="empty-subtitle text-secondary">@L["This module is planned for a later build phase."]</p>
    <div class="empty-action">
        <a href="" class="btn btn-primary"><i class="ti ti-arrow-left me-1"></i>@L["Back to dashboard"]</a>
    </div>
</div>

@code {
    [Parameter] public string Module { get; set; } = "";

    private string Title => string.IsNullOrEmpty(Module)
        ? "Module"
        : char.ToUpperInvariant(Module[0]) + Module[1..].Replace('-', ' ');
}
