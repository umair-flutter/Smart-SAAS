@page "/monitoring/audit"
@inherits ListPageBase<AuditLogDto>

<PageTitle>@L["Audit trail"] · SmartSchool</PageTitle>

<div class="page-header mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">@L["Monitoring"]</div>
            <h1 class="page-title">@L["Audit trail"]</h1>
        </div>
        <div class="col-auto ms-auto">
            <div class="btn-group">
                <button class="btn @(_timeline ? "" : "btn-primary")" @onclick="() => _timeline = false"><i class="ti ti-table me-1"></i>@L["Table"]</button>
                <button class="btn @(_timeline ? "btn-primary" : "")" @onclick="() => _timeline = true"><i class="ti ti-timeline me-1"></i>@L["Timeline"]</button>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <div class="input-icon" style="max-width:240px; flex:1 1 200px">
            <span class="input-icon-addon"><i class="ti ti-search"></i></span>
            <input type="search" class="form-control" placeholder="@L["Search user or description…"]" @oninput="OnSearchInput" />
        </div>
        <select class="form-select" style="max-width:190px" @onchange="e => SetFilter(() => _entity = e.Value?.ToString())">
            <option value="">@L["All records"]</option>
            @foreach (var t in _types) { <option value="@t">@L[t]</option> }
        </select>
        <select class="form-select" style="max-width:170px" @onchange="e => SetFilter(() => _action = Enum.TryParse<AuditAction>(e.Value?.ToString(), out var a) ? a : null)">
            <option value="">@L["All actions"]</option>
            @foreach (var a in Enum.GetValues<AuditAction>()) { <option value="@a">@L[a.ToString()]</option> }
        </select>
        <input type="date" class="form-control" style="max-width:160px" title="@L["From"]" @onchange="e => SetFilter(() => _from = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
        <input type="date" class="form-control" style="max-width:160px" title="@L["To"]" @onchange="e => SetFilter(() => _to = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
    </div>
</div>

@if (LoadError is not null) { <div class="alert alert-danger">@LoadError</div> }

@if (_timeline)
{
    <div class="card">
        <div class="card-body">
            @if (Result?.Items.Count == 0) { <div class="text-secondary">@L["No activity in this period."]</div> }
            @foreach (var day in (Result?.Items ?? []).GroupBy(a => a.TimestampUtc.ToLocalTime().Date))
            {
                <h4 class="text-secondary mt-2">@day.Key.ToString("D")</h4>
                <ul class="timeline">
                    @foreach (var a in day)
                    {
                        <li class="timeline-event">
                            <div class="timeline-event-icon @IconBg(a.Action)"><i class="ti @Icon(a.Action)"></i></div>
                            <div class="card timeline-event-card">
                                <div class="card-body py-2">
                                    <div class="text-secondary float-end small">@a.TimestampUtc.ToLocalTime().ToString("t")</div>
                                    <div><span class="fw-semibold">@(a.UserName ?? L["System"])</span> · @a.Summary</div>
                                    <AuditChanges Json="@a.Changes" />
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
        <Pager Page="@(Result?.Page ?? 1)" PageSize="@(Result?.PageSize ?? 20)" TotalCount="@(Result?.TotalCount ?? 0)" OnPage="GoToPage" />
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead><tr><th>@L["When"]</th><th>@L["User"]</th><th>@L["Action"]</th><th>@L["Record"]</th><th>@L["Details"]</th><th>@L["IP address"]</th></tr></thead>
                <tbody>
                    @if (Result?.Items.Count == 0) { <tr><td colspan="6" class="text-secondary text-center py-4">@L["No activity in this period."]</td></tr> }
                    @foreach (var a in Result?.Items ?? [])
                    {
                        <tr>
                            <td class="small text-secondary text-nowrap">@a.TimestampUtc.ToLocalTime().ToString("g")</td>
                            <td class="fw-semibold">@(a.UserName ?? L["System"])</td>
                            <td><span class="badge @IconBg(a.Action)">@L[a.Action.ToString()]</span></td>
                            <td class="small">@L[a.EntityType]</td>
                            <td class="small" style="max-width:420px">@a.Summary <AuditChanges Json="@a.Changes" /></td>
                            <td class="small"><code>@a.IpAddress</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="@(Result?.Page ?? 1)" PageSize="@(Result?.PageSize ?? 20)" TotalCount="@(Result?.TotalCount ?? 0)" OnPage="GoToPage" />
    </div>
}

@code {
    protected override string Endpoint => "api/monitoring/audit";
    protected override string? ExtraQuery => string.Join('&', new[]
    {
        string.IsNullOrEmpty(_entity) ? null : $"entityType={_entity}",
        _action is null ? null : $"action={_action}",
        _from is null ? null : $"from={_from:yyyy-MM-dd}",
        _to is null ? null : $"to={_to:yyyy-MM-dd}"
    }.Where(x => x is not null));

    private bool _timeline;
    private string? _entity;
    private AuditAction? _action;
    private DateOnly? _from, _to;
    private List<string> _types = [];

    protected override async Task OnInitializedPageAsync()
    {
        try { _types = await Api.GetAsync<List<string>>("api/monitoring/audit/entity-types"); } catch (ApiException) { }
    }

    private async Task SetFilter(Action set)
    {
        set();
        Query.Page = 1;
        await LoadAsync();
    }

    private static string Icon(AuditAction a) => a switch
    {
        AuditAction.Created => "ti-plus",
        AuditAction.Updated => "ti-pencil",
        AuditAction.Deleted => "ti-trash",
        AuditAction.SignedIn => "ti-login",
        AuditAction.SignedOut => "ti-logout",
        AuditAction.SignInFailed => "ti-lock-x",
        _ => "ti-download"
    };

    private static string IconBg(AuditAction a) => a switch
    {
        AuditAction.Created => "bg-green-lt",
        AuditAction.Updated => "bg-blue-lt",
        AuditAction.Deleted => "bg-red-lt",
        AuditAction.SignInFailed => "bg-orange-lt",
        _ => "bg-secondary-lt"
    };
}
