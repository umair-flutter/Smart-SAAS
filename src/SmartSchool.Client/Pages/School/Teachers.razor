@page "/teachers"
@inherits ListPageBase<TeacherDto>

<PageTitle>@L["Teachers"] · SmartSchool</PageTitle>

<div class="page-header mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">@L["School"]</div>
            <h1 class="page-title">@L["Teachers"]</h1>
        </div>
        @if (CanManage && State.ActiveSchoolId is not null)
        {
            <div class="col-auto ms-auto"><button class="btn btn-primary" @onclick="New"><i class="ti ti-plus me-1"></i>@L["New teacher"]</button></div>
        }
    </div>
</div>

<SchoolHint />

<div class="card">
    <div class="card-body border-bottom py-3">
        <div class="input-icon" style="max-width:320px">
            <span class="input-icon-addon"><i class="ti ti-search"></i></span>
            <input type="search" class="form-control" placeholder="@L["Search name, email or employee no…"]" @oninput="OnSearchInput" />
        </div>
    </div>
    @if (LoadError is not null)
    {
        <div class="card-body"><div class="alert alert-danger mb-0">@LoadError</div></div>
    }
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <SortHeader Title="@L["Teacher"]" Column="name" Current="@Query.SortBy" Desc="@Query.SortDesc" OnSort="SortBy" />
                    <SortHeader Title="@L["Specialty"]" Column="specialty" Current="@Query.SortBy" Desc="@Query.SortDesc" OnSort="SortBy" />
                    <th>@L["Subjects taught"]</th>
                    <th class="text-center">@L["Classes"]</th>
                    <SortHeader Title="@L["Hired"]" Column="hired" Current="@Query.SortBy" Desc="@Query.SortDesc" OnSort="SortBy" />
                    <th>@L["Status"]</th>
                    <th class="w-1"></th>
                </tr>
            </thead>
            <tbody>
                @if (Result?.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-secondary text-center py-4">@L["No teachers found."]</td></tr>
                }
                @foreach (var t in Result?.Items ?? [])
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@t.FullName <PersonStatus S="t.Status" /> @if (t.HasLogin) { <i class="ti ti-key text-success ms-1" title="@L["Has a sign-in account"]"></i> }</div>
                            <div class="small text-secondary">@t.Email @(t.EmployeeNo is null ? "" : $"· {t.EmployeeNo}")</div>
                        </td>
                        <td>@t.Specialty</td>
                        <td class="small">@string.Join(", ", t.Subjects)</td>
                        <td class="text-center">@t.ClassCount</td>
                        <td class="text-secondary small">@t.HireDate?.ToString("yyyy-MM-dd")</td>
                        <td>@if (t.IsActive) { <span class="badge bg-green-lt">@L["Active"]</span> } else { <span class="badge bg-secondary-lt">@L["Inactive"]</span> }</td>
                        <td>
                            @if (CanManage)
                            {
                                <div class="btn-list flex-nowrap">
                                    <button class="btn btn-sm btn-icon btn-ghost-primary" title="@L["Edit"]" @onclick="() => Edit(t)"><i class="ti ti-pencil"></i></button>
                                    <button class="btn btn-sm btn-icon btn-ghost-danger" title="@L["Delete"]" @onclick="() => Delete(t)"><i class="ti ti-trash"></i></button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Page="@(Result?.Page ?? 1)" PageSize="@(Result?.PageSize ?? 20)" TotalCount="@(Result?.TotalCount ?? 0)" OnPage="GoToPage" />
</div>

<Modal @bind-Visible="_editing" Title="@(_editId is null ? L["New teacher"] : L["Edit teacher"])" Size="lg">
    <ChildContent>
        <EditForm Model="_form" OnValidSubmit="Save" id="teacher-form">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label required">@L["First name"]</label>
                    <InputText class="form-control" @bind-Value="_form.FirstName" />
                    <ValidationMessage For="() => _form.FirstName" class="invalid-feedback d-block" />
                </div>
                <div class="col-md-6">
                    <label class="form-label required">@L["Last name"]</label>
                    <InputText class="form-control" @bind-Value="_form.LastName" />
                    <ValidationMessage For="() => _form.LastName" class="invalid-feedback d-block" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Email"]</label>
                    <InputText class="form-control" type="email" @bind-Value="_form.Email" />
                    <ValidationMessage For="() => _form.Email" class="invalid-feedback d-block" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Phone"]</label>
                    <InputText class="form-control" @bind-Value="_form.Phone" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Employee no."]</label>
                    <InputText class="form-control" @bind-Value="_form.EmployeeNo" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Specialty"]</label>
                    <InputText class="form-control" @bind-Value="_form.Specialty" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Hire date"]</label>
                    <InputDate class="form-control" @bind-Value="_form.HireDate" />
                </div>
                <div class="col-12">
                    <label class="form-label">@L["Address"]</label>
                    <InputText class="form-control" @bind-Value="_form.Address" />
                </div>
                <div class="col-12">
                    <label class="form-check form-switch">
                        <InputCheckbox class="form-check-input" @bind-Value="_form.IsActive" />
                        <span class="form-check-label">@L["Active"]</span>
                    </label>
                </div>
                <StatusSelect Model="_form" Category="StatusCategory.Teacher" />
                <LoginFields Model="_form" HasLogin="_hasLogin" RoleLabel="Teacher" />
            </div>
            @if (_saveError is not null) { <div class="alert alert-danger mt-3 mb-0">@_saveError</div> }
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="btn btn-link link-secondary" @onclick="() => _editing = false">Cancel</button>
        <button class="btn btn-primary ms-auto" type="submit" form="teacher-form" disabled="@_saving">@L["Save"]</button>
    </Footer>
</Modal>

<ConfirmDialog @ref="_confirm" />

@code {
    protected override string Endpoint => "api/teachers";

    private bool CanManage => State.Can(Permissions.Teachers.Manage);
    private bool _editing;
    private bool _saving;
    private bool _hasLogin;
    private Guid? _editId;
    private string? _saveError;
    private TeacherEditDto _form = new();
    private ConfirmDialog _confirm = default!;

    private void New()
    {
        _form = new TeacherEditDto();
        _editId = null;
        _hasLogin = false;
        _saveError = null;
        _editing = true;
    }

    private async Task Edit(TeacherDto t)
    {
        try
        {
            _form = await Api.GetAsync<TeacherEditDto>($"api/teachers/{t.Id}");
            _hasLogin = _form.CreateLogin;
            _editId = t.Id;
            _saveError = null;
            _editing = true;
        }
        catch (ApiException ex) { Toasts.Error(ex.Friendly); }
    }

    private async Task Save()
    {
        _saving = true;
        _saveError = null;
        try
        {
            if (_editId is { } id) await Api.PutAsync($"api/teachers/{id}", _form);
            else await Api.PostAsync<object>("api/teachers", _form);
            _editing = false;
            Toasts.Success(L["Teacher saved."]);
            await LoadAsync();
        }
        catch (ApiException ex) { _saveError = ex.Friendly; }
        finally { _saving = false; }
    }

    private async Task Delete(TeacherDto t)
    {
        if (!await _confirm.AskAsync(L["Delete teacher?"], $"{t.FullName} will be removed. A linked sign-in account is kept.")) return;
        try
        {
            await Api.DeleteAsync($"api/teachers/{t.Id}");
            Toasts.Success(L["Teacher deleted."]);
            await LoadAsync();
        }
        catch (ApiException ex) { Toasts.Error(ex.Friendly); }
    }
}
