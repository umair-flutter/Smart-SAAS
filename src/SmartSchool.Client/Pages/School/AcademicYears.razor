@page "/academic-years"
@implements IDisposable
@inject ApiClient Api
@inject AppState State
@inject ToastService Toasts

<PageTitle>@L["Academic years"] · SmartSchool</PageTitle>

<div class="page-header mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">@L["School"]</div>
            <h1 class="page-title">@L["Academic years"]</h1>
        </div>
        @if (CanManage && State.ActiveSchoolId is not null)
        {
            <div class="col-auto ms-auto"><button class="btn btn-primary" @onclick="New"><i class="ti ti-plus me-1"></i>@L["New academic year"]</button></div>
        }
    </div>
</div>

<SchoolHint />

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_years is null)
{
    <div class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>
}
else if (_years.Count == 0)
{
    <div class="empty"><p class="empty-title">@L["No academic years yet"]</p><p class="empty-subtitle text-secondary">@L["Create the first year and its terms to start adding classes."]</p></div>
}
else
{
    <div class="row row-cards">
        @foreach (var y in _years)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 @(y.IsCurrent ? "border-primary" : "")">
                    <div class="card-header">
                        <h3 class="card-title">@y.Name</h3>
                        @if (y.IsCurrent) { <span class="badge bg-primary-lt ms-2">@L["Current"]</span> }
                        @if (CanManage)
                        {
                            <div class="card-actions btn-list">
                                <button class="btn btn-sm btn-icon btn-ghost-primary" title="@L["Edit"]" @onclick="() => Edit(y)"><i class="ti ti-pencil"></i></button>
                                @if (y.ClassCount == 0)
                                {
                                    <button class="btn btn-sm btn-icon btn-ghost-danger" title="@L["Delete"]" @onclick="() => Delete(y)"><i class="ti ti-trash"></i></button>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="text-secondary mb-2">@y.StartDate.ToString("yyyy-MM-dd") to @y.EndDate.ToString("yyyy-MM-dd")</div>
                        <div class="d-flex gap-3 mb-3 small">
                            <span><i class="ti ti-users-group me-1"></i>@y.ClassCount classes</span>
                            <span><i class="ti ti-user-star me-1"></i>@y.StudentCount students</span>
                        </div>
                        @foreach (var t in y.Terms)
                        {
                            <div class="d-flex justify-content-between border-top py-2 small">
                                <span class="fw-semibold">@t.Name</span>
                                <span class="text-secondary">@t.StartDate.ToString("MMM d") – @t.EndDate.ToString("MMM d, yyyy")</span>
                            </div>
                        }
                        @if (y.Terms.Count == 0) { <div class="text-secondary small">@L["No terms defined."]</div> }
                    </div>
                </div>
            </div>
        }
    </div>
}

<Modal @bind-Visible="_editing" Title="@(_editId is null ? L["New academic year"] : L["Edit academic year"])" Size="lg">
    <ChildContent>
        <EditForm Model="_form" OnValidSubmit="Save" id="year-form">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label required">@L["Name"]</label>
                    <InputText class="form-control" placeholder="2026-2027" @bind-Value="_form.Name" />
                    <ValidationMessage For="() => _form.Name" class="invalid-feedback d-block" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Starts"]</label>
                    <InputDate class="form-control" @bind-Value="_form.StartDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Ends"]</label>
                    <InputDate class="form-control" @bind-Value="_form.EndDate" />
                </div>
                <div class="col-12">
                    <label class="form-check form-switch">
                        <InputCheckbox class="form-check-input" @bind-Value="_form.IsCurrent" />
                        <span class="form-check-label">@L["Current year (used by default across the school)"]</span>
                    </label>
                </div>
            </div>

            <div class="d-flex align-items-center mt-3 mb-2">
                <h4 class="mb-0">@L["Terms"]</h4>
                <button type="button" class="btn btn-sm ms-auto" @onclick="AddTerm"><i class="ti ti-plus me-1"></i>@L["Add term"]</button>
            </div>
            @foreach (var t in _form.Terms)
            {
                <div class="row g-2 mb-2 align-items-center">
                    <div class="col-md-4"><input class="form-control" placeholder="@L["Term name"]" @bind="t.Name" /></div>
                    <div class="col-md-3"><input type="date" class="form-control" @bind="t.StartDate" /></div>
                    <div class="col-md-3"><input type="date" class="form-control" @bind="t.EndDate" /></div>
                    <div class="col-md-2"><button type="button" class="btn btn-sm btn-ghost-danger" @onclick="() => _form.Terms.Remove(t)"><i class="ti ti-x me-1"></i>@L["Remove"]</button></div>
                </div>
            }
            @if (_saveError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0">@_saveError</div>
            }
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="btn btn-link link-secondary" @onclick="() => _editing = false">Cancel</button>
        <button class="btn btn-primary ms-auto" type="submit" form="year-form" disabled="@_saving">@L["Save"]</button>
    </Footer>
</Modal>

<ConfirmDialog @ref="_confirm" />

@code {
    private List<AcademicYearDto>? _years;
    private string? _error;
    private bool _editing;
    private bool _saving;
    private Guid? _editId;
    private string? _saveError;
    private AcademicYearEditDto _form = new();
    private ConfirmDialog _confirm = default!;

    private bool CanManage => State.Can(Permissions.AcademicYears.Manage);

    protected override async Task OnInitializedAsync()
    {
        State.ContextChanged += Load;
        await Load();
    }

    private async Task Load()
    {
        _error = null;
        try { _years = await Api.GetAsync<List<AcademicYearDto>>("api/academic-years"); }
        catch (ApiException ex) { _error = ex.Friendly; }
        await InvokeAsync(StateHasChanged);
    }

    private void New()
    {
        var start = DateTime.Today.Month >= 8 ? DateTime.Today.Year : DateTime.Today.Year - 1;
        if (_years?.Count > 0) start = _years.Max(y => y.StartDate.Year) + 1;
        _form = new AcademicYearEditDto
        {
            Name = $"{start}-{start + 1}",
            StartDate = new DateOnly(start, 9, 1),
            EndDate = new DateOnly(start + 1, 6, 30),
            IsCurrent = _years?.Count == 0,
            Terms =
            [
                new() { Name = "Term 1", StartDate = new(start, 9, 1), EndDate = new(start, 12, 20) },
                new() { Name = "Term 2", StartDate = new(start + 1, 1, 5), EndDate = new(start + 1, 3, 28) },
                new() { Name = "Term 3", StartDate = new(start + 1, 4, 13), EndDate = new(start + 1, 6, 30) }
            ]
        };
        _editId = null;
        _saveError = null;
        _editing = true;
    }

    private void Edit(AcademicYearDto y)
    {
        _form = new AcademicYearEditDto
        {
            Name = y.Name, StartDate = y.StartDate, EndDate = y.EndDate, IsCurrent = y.IsCurrent,
            Terms = y.Terms.Select(t => new TermDto { Id = t.Id, Name = t.Name, StartDate = t.StartDate, EndDate = t.EndDate }).ToList()
        };
        _editId = y.Id;
        _saveError = null;
        _editing = true;
    }

    private void AddTerm()
    {
        var last = _form.Terms.LastOrDefault();
        var start = last is null ? _form.StartDate : last.EndDate.AddDays(1);
        _form.Terms.Add(new TermDto { Name = $"Term {_form.Terms.Count + 1}", StartDate = start, EndDate = start.AddMonths(3) > _form.EndDate ? _form.EndDate : start.AddMonths(3) });
    }

    private async Task Save()
    {
        _saving = true;
        _saveError = null;
        try
        {
            if (_editId is { } id) await Api.PutAsync($"api/academic-years/{id}", _form);
            else await Api.PostAsync<object>("api/academic-years", _form);
            _editing = false;
            Toasts.Success(L["Academic year saved."]);
            await Load();
        }
        catch (ApiException ex) { _saveError = ex.Friendly; }
        finally { _saving = false; }
    }

    private async Task Delete(AcademicYearDto y)
    {
        if (!await _confirm.AskAsync(L["Delete academic year?"], $"{y.Name} and its terms will be removed.")) return;
        try
        {
            await Api.DeleteAsync($"api/academic-years/{y.Id}");
            Toasts.Success(L["Academic year deleted."]);
            await Load();
        }
        catch (ApiException ex) { Toasts.Error(ex.Friendly); }
    }

    public void Dispose() => State.ContextChanged -= Load;
}
