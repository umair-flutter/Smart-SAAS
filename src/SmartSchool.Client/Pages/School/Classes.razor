@page "/classes"
@implements IDisposable
@inject ApiClient Api
@inject AppState State
@inject ToastService Toasts

<PageTitle>@L["Classes"] · SmartSchool</PageTitle>

<div class="page-header mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">@L["School"]</div>
            <h1 class="page-title">@L["Classes"]</h1>
        </div>
        @if (CanManage && State.ActiveSchoolId is not null)
        {
            <div class="col-auto ms-auto"><button class="btn btn-primary" @onclick="New"><i class="ti ti-plus me-1"></i>@L["New class"]</button></div>
        }
    </div>
</div>

<SchoolHint />

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_classes is null)
{
    <div class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>
}
else if (_classes.Count == 0)
{
    <div class="empty"><p class="empty-title">@L["No classes in this academic year"]</p><p class="empty-subtitle text-secondary">@L["Create classes, then enrol students and assign teachers."]</p></div>
}
else
{
    @foreach (var level in _classes.GroupBy(c => c.Level ?? "Other"))
    {
        <h3 class="mt-2 mb-2 text-secondary">@level.Key</h3>
        <div class="row row-cards mb-3">
            @foreach (var c in level)
            {
                var pct = c.Capacity == 0 ? 0 : Math.Min(100, c.StudentCount * 100 / c.Capacity);
                <div class="col-sm-6 col-xl-3">
                    <a class="card card-link h-100" href="classes/@c.Id">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h3 class="mb-1">@c.Name</h3>
                                <span class="badge bg-blue-lt">@c.AcademicYearName</span>
                            </div>
                            <div class="text-secondary small mb-3">
                                <i class="ti ti-user me-1"></i>@(c.HomeroomTeacherName ?? "No homeroom teacher")<br />
                                <i class="ti ti-door me-1"></i>@(c.RoomName ?? "No room")
                            </div>
                            <div class="d-flex justify-content-between small mb-1"><span>Students</span><span class="fw-semibold">@c.StudentCount / @c.Capacity</span></div>
                            <div class="progress progress-sm"><div class="progress-bar @(pct >= 100 ? "bg-danger" : "")" style="width:@(pct)%"></div></div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
}

<Modal @bind-Visible="_editing" Title="@L["New class"]">
    <ChildContent>
        <ClassForm Model="_form" Lookups="_lookups" FormId="class-form" OnValidSubmit="Save" />
        @if (_saveError is not null) { <div class="alert alert-danger mt-3 mb-0">@_saveError</div> }
    </ChildContent>
    <Footer>
        <button class="btn btn-link link-secondary" @onclick="() => _editing = false">Cancel</button>
        <button class="btn btn-primary ms-auto" type="submit" form="class-form" disabled="@_saving">@L["Create class"]</button>
    </Footer>
</Modal>

@code {
    private List<ClassDto>? _classes;
    private SchoolLookupsDto? _lookups;
    private string? _error;
    private bool _editing;
    private bool _saving;
    private string? _saveError;
    private ClassEditDto _form = new();

    private bool CanManage => State.Can(Permissions.Classes.Manage);

    protected override async Task OnInitializedAsync()
    {
        State.ContextChanged += Load;
        await Load();
    }

    private async Task Load()
    {
        _error = null;
        try { _classes = await Api.GetAsync<List<ClassDto>>("api/classes"); }
        catch (ApiException ex) { _error = ex.Friendly; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task New()
    {
        try { _lookups = await Api.GetAsync<SchoolLookupsDto>("api/school/lookups"); }
        catch (ApiException ex) { Toasts.Error(ex.Friendly); return; }
        _form = new ClassEditDto { AcademicYearId = _lookups.AcademicYearId };
        _saveError = null;
        _editing = true;
    }

    private async Task Save()
    {
        _saving = true;
        _saveError = null;
        try
        {
            await Api.PostAsync<object>("api/classes", _form);
            _editing = false;
            Toasts.Success(L["Class created."]);
            await Load();
        }
        catch (ApiException ex) { _saveError = ex.Friendly; }
        finally { _saving = false; }
    }

    public void Dispose() => State.ContextChanged -= Load;
}
