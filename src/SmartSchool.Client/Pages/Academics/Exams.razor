@page "/exams"
@implements IDisposable
@inject ApiClient Api
@inject AppState State
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@L["Exams & results"] · SmartSchool</PageTitle>

<div class="page-header mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">@L["Academics"]</div>
            <h1 class="page-title">@L["Exams & results"]</h1>
        </div>
        @if (CanCreate)
        {
            <div class="col-auto ms-auto"><button class="btn btn-primary" @onclick="New"><i class="ti ti-plus me-1"></i>@L["New exam"]</button></div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        @if (IsFamily)
        {
            <StudentPicker Selected="_studentId" OnSelected="OnStudentSelected" />
        }
        else
        {
            <select class="form-select" style="max-width:200px" @onchange="e => SetFilter(e, v => _classId = v)">
                <option value="">@L["All classes"]</option>
                @foreach (var c in _lookups?.Classes ?? []) { <option value="@c.Id">@c.Name</option> }
            </select>
        }
        <select class="form-select" style="max-width:200px" @onchange="e => SetFilter(e, v => _subjectId = v)">
            <option value="">@L["All subjects"]</option>
            @foreach (var s in _lookups?.Subjects ?? []) { <option value="@s.Id">@s.Name</option> }
        </select>
        <select class="form-select" style="max-width:160px" @onchange="e => SetFilter(e, v => _termId = v)">
            <option value="">@L["All terms"]</option>
            @foreach (var t in _lookups?.Terms ?? []) { <option value="@t.Id">@t.Name</option> }
        </select>
    </div>
</div>

@if (_error is not null) { <div class="alert alert-danger">@_error</div> }

<div class="card">
    <div class="table-responsive">
        <table class="table card-table table-vcenter table-hover">
            <thead><tr><th>@L["Exam"]</th><th>@L["Class"]</th><th>@L["Date"]</th><th>@L["Term"]</th><th class="text-center">@L["Out of"]</th><th class="text-center">@L["Weight"]</th><th>@(IsFamily ? "Result" : "Results")</th></tr></thead>
            <tbody>
                @if (_exams is null) { <tr><td colspan="7" class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</td></tr> }
                else if (_exams.Count == 0) { <tr><td colspan="7" class="text-secondary text-center py-4">@L["No exams found."]</td></tr> }
                @foreach (var e in _exams ?? [])
                {
                    <tr role="button" @onclick='() => Nav.NavigateTo(IsFamily && _studentId is { } s ? $"exams/{e.Id}?studentId={s}" : $"exams/{e.Id}")'>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="rounded" style="width:4px;height:32px;background:@e.SubjectColor"></span>
                                <div><div class="fw-semibold">@e.Title</div><div class="small text-secondary">@e.SubjectName · @e.Type</div></div>
                            </div>
                        </td>
                        <td>@e.ClassName</td>
                        <td>@e.Date.ToString("ddd d MMM")</td>
                        <td>@e.TermName</td>
                        <td class="text-center">@e.MaxScore.ToString("0.##")</td>
                        <td class="text-center">×@e.Weight.ToString("0.##")</td>
                        <td>
                            @if (IsFamily)
                            {
                                @if (!e.ResultsPublished) { <span class="badge bg-secondary-lt">@L["Not published"]</span> }
                                else if (e.MyAbsent == true) { <span class="badge bg-red-lt">@L["Absent"]</span> }
                                else if (e.MyScore is { } sc) { <span class="fw-bold">@sc.ToString("0.##")</span><span class="text-secondary"> / @e.MaxScore.ToString("0.##")</span> <span class="small text-secondary ms-1">class avg @e.Average?.ToString("0.##")</span> }
                                else { <span class="text-secondary">—</span> }
                            }
                            else
                            {
                                <span class="small">@e.ResultCount entered · avg @(e.Average?.ToString("0.##") ?? "—")</span>
                                @if (e.ResultsPublished) { <span class="badge bg-green-lt ms-1">@L["Published"]</span> } else { <span class="badge bg-secondary-lt ms-1">@L["Draft"]</span> }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<Modal @bind-Visible="_editing" Title="@L["New exam"]" Size="lg">
    <ChildContent>
        <ExamForm Model="_form" Lookups="_lookups" FormId="exam-form" OnValidSubmit="Save" />
        @if (_saveError is not null) { <div class="alert alert-danger mt-3 mb-0">@_saveError</div> }
    </ChildContent>
    <Footer>
        <button class="btn btn-link link-secondary" @onclick="() => _editing = false">Cancel</button>
        <button class="btn btn-primary ms-auto" type="submit" form="exam-form" disabled="@_saving">@L["Create"]</button>
    </Footer>
</Modal>

@code {
    private List<ExamDto>? _exams;
    private SchoolLookupsDto? _lookups;
    private Guid? _classId, _subjectId, _termId, _studentId;
    private string? _error, _saveError;
    private bool _editing, _saving;
    private ExamEditDto _form = new();

    private bool IsFamily => State.User?.RoleType is RoleType.Parent or RoleType.Student;
    private bool CanCreate => State.Can(Permissions.Exams.EnterResults) && !IsFamily;

    protected override async Task OnInitializedAsync()
    {
        State.ContextChanged += Reload;
        await Reload();
    }

    private async Task Reload()
    {
        try { _lookups = await Api.GetAsync<SchoolLookupsDto>("api/school/lookups"); } catch (ApiException) { }
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Load()
    {
        _error = null;
        var q = string.Join('&', new[]
        {
            _classId is null ? null : $"classId={_classId}", _subjectId is null ? null : $"subjectId={_subjectId}",
            _termId is null ? null : $"termId={_termId}", _studentId is null ? null : $"studentId={_studentId}"
        }.Where(x => x is not null));
        try { _exams = await Api.GetAsync<List<ExamDto>>($"api/exams?{q}"); }
        catch (ApiException ex) { _error = ex.Friendly; }
    }

    private async Task SetFilter(ChangeEventArgs e, Action<Guid?> set)
    {
        set(Guid.TryParse(e.Value?.ToString(), out var g) ? g : null);
        await Load();
    }

    private async Task OnStudentSelected(MyStudentDto s) { _studentId = s.StudentId; await Load(); }

    private void New()
    {
        _form = new ExamEditDto { ClassId = _classId, SubjectId = _subjectId, TermId = _termId };
        _saveError = null;
        _editing = true;
    }

    private async Task Save()
    {
        _saving = true;
        _saveError = null;
        try
        {
            var created = await Api.PostAsync<Dictionary<string, Guid>>("api/exams", _form);
            _editing = false;
            Toasts.Success(L["Exam created. Enter the results below."]);
            Nav.NavigateTo($"exams/{created["id"]}");
        }
        catch (ApiException ex) { _saveError = ex.Friendly; }
        finally { _saving = false; }
    }

    public void Dispose() => State.ContextChanged -= Reload;
}
