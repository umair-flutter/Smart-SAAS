<Modal @bind-Visible="_visible" Title="@_title" Size="sm">
    <ChildContent>
        <div class="text-center py-2">
            <i class="ti ti-alert-triangle text-danger" style="font-size:2.5rem"></i>
            <p class="mt-2 mb-0">@_message</p>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-link link-secondary" @onclick="() => Finish(false)">Cancel</button>
        <button class="btn btn-danger ms-auto" @onclick="() => Finish(true)">@_confirmText</button>
    </Footer>
</Modal>

@code {
    private bool _visible;
    private string _title = "";
    private string _message = "";
    private string _confirmText = "Delete";
    private TaskCompletionSource<bool>? _tcs;

    /// <summary>Shows the dialog and resolves to true when the user confirms.</summary>
    public Task<bool> AskAsync(string title, string message, string confirmText = "Delete")
    {
        _title = title;
        _message = message;
        _confirmText = confirmText;
        _visible = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    private void Finish(bool result)
    {
        _visible = false;
        _tcs?.TrySetResult(result);
    }
}
